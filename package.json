{
  "name": "platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A record of every train journey taken across India, drawn as a map that fills in as you travel.",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "data:build": "node scripts/build-stations.ts",
    "map:build": "node scripts/build-map.ts",
    "assets": "npm run map:build && npm run data:build && npm run routes:build",
    "routes:build": "node scripts/build-routes.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "d3-geo": "^3.1.1",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "topojson-client": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "mapshaper": "^0.7.55",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
