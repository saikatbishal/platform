# Copy to .env and fill in. .env is gitignored.
# Anything prefixed VITE_ is compiled into the browser bundle — only ever
# put values here that are safe to be public.
# Values containing YOUR_ are treated as placeholders: the app runs in
# preview mode (sample data, sign-in disabled) until they are real.

# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side only (Edge Function secrets, set via CLI — never VITE_):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set SUPABASE_AUTH_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
#   supabase secrets set SUPABASE_AUTH_GOOGLE_SECRET=GOCSPX-...
