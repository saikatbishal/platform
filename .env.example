# Copy to .env and fill in. .env is gitignored.
# Anything prefixed VITE_ is compiled into the browser bundle — only ever
# put values here that are safe to be public.
# Values containing YOUR_ are treated as placeholders: the app runs in
# demo mode (sign-in opens a browser-local session) until they are real.

# Supabase → Settings → API Keys.
# Use the *publishable* key (starts sb_publishable_). The old JWT-shaped
# "anon" key still works and is still read as VITE_SUPABASE_ANON_KEY, but
# Supabase deprecates it at the end of 2026.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Server-side only (Edge Function secrets, set via CLI — never VITE_):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# The Google client secret is pasted into the Supabase dashboard, not here.