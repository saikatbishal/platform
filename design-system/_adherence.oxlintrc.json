{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/auth/**",
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "ui_kits/platform-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Fallback|Archivo|IBM Plex Mono|IBM Plex Sans Devanagari|Noto Sans Bengali))/i]",
        "message": "Font not provided by the design system. Available: Archivo Fallback, Archivo, IBM Plex Mono, IBM Plex Sans Devanagari, Noto Sans Bengali."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|onClick|children|key|ref|className|style|children)$/]",
        "message": "<BoardChip> doesn't accept that prop. Declared props: code, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MilestoneStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|detail|achieved|key|ref|className|style|children)$/]",
        "message": "<MilestoneStatus> doesn't accept that prop. Declared props: id, label, detail, achieved."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlatformCanopy'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|key|ref|className|style|children)$/]",
        "message": "<PlatformCanopy> doesn't accept that prop. Declared props: height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|open|onClose|width|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: title, open, onClose, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignInButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|busy|onSignIn|key|ref|className|style|children)$/]",
        "message": "<SignInButton> doesn't accept that prop. Declared props: mode, busy, onSignIn."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignInButton'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:google|demo)$/]",
        "message": "<SignInButton> mode must be one of 'google' | 'demo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: label, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warn)$/]",
        "message": "<Stat> tone must be one of 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StationBoard'] > JSXAttribute > JSXIdentifier[name!=/^(?:devanagari|latin|regional|code|zone|size|key|ref|className|style|children)$/]",
        "message": "<StationBoard> doesn't accept that prop. Declared props: devanagari, latin, regional, code, zone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StationBoard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StationBoard> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StationHit'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|name|state|key|ref|className|style|children)$/]",
        "message": "<StationHit> doesn't accept that prop. Declared props: code, name, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|htmlFor|optional|key|ref|className|style|children)$/]",
        "message": "<FieldLabel> doesn't accept that prop. Declared props: children, htmlFor, optional."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthUser'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|email|avatarUrl|key|ref|className|style|children)$/]",
        "message": "<AuthUser> doesn't accept that prop. Declared props: name, email, avatarUrl."
      },
      {
        "selector": "JSXOpeningElement[name.name='VersionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|version|key|ref|className|style|children)$/]",
        "message": "<VersionBadge> doesn't accept that prop. Declared props: name, version."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
